{
  "name": "open-haxball",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/client"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:client",
    "dev:server": "cd packages/server-rust && cargo run",
    "dev:client": "npm run dev -w @open-haxball/client",
    "start": "npm run start:server & npm run start:client",
    "start:server": "cd packages/server-rust && cargo run --release",
    "start:client": "npm run start -w @open-haxball/client",
    "build": "npm run build -w @open-haxball/shared && npm run build:server && npm run build -w @open-haxball/client",
    "build:shared": "npm run build -w @open-haxball/shared",
    "build:server": "cd packages/server-rust && cargo build --release",
    "build:client": "npm run build -w @open-haxball/client"
  }
}
